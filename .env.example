POSTGRES_DB=credit_intelligence
POSTGRES_USER=credit_app
POSTGRES_PASSWORD=local_demo_only_change_me
DEMO_ANALYST_USER=analyst
DEMO_ANALYST_PASSWORD=local_demo_only_change_me
AI_PROVIDER=bedrock
BUREAU_MODE=sandbox
# The application calls the real Consult Center sandbox response; it never substitutes a mock.
BUREAU_SANDBOX_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=deepseek.v3.2
# Docker receives credentials through standard environment variables.
# Keep this file local/ignored. In CI or cloud, inject these variables from a secret store or IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_READ_TIMEOUT_SECONDS=60
BEDROCK_MAX_ATTEMPTS=3
DOCUMENT_INTELLIGENCE_CONNECT_TIMEOUT_MS=5000
DOCUMENT_INTELLIGENCE_READ_TIMEOUT_MS=90000
ANALYSIS_LEASE_DURATION_SECONDS=180
BACKEND_PORT=18080
FRONTEND_PORT=18081
INTERNAL_SERVICE_TOKEN=local_internal_token_change_me
